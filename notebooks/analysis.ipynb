    "import duckdb\n",
    "\n",
    "con = duckdb.connect()\n",
    "con.sql(\"\"\"\n",
    "    SELECT COUNT(*) AS total_rows,\n",
    "           COUNT(DISTINCT pl_name) as unique_planets\n",
    "    FROM read_parquet('../data/raw/planetary_systems_raw.parquet')\n",
    "    LIMIT 5\n",
    "\"\"\")"
   ]
  }
